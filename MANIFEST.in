include README.md LICENSE AGENTS.md CONTRIBUTING.md pipeline.py
recursive-include docs *.md *.png
recursive-include tests *.py *.json *.yaml *.html
recursive-include llm *.md *.json
recursive-include db *.sql
recursive-include .github *.yml
global-exclude *.pyc *.pyo *.sqlite *.sqlite3 *.log
prune __pycache__
