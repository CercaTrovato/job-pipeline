{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match/v1",
  "type": "object",
  "required": ["items", "rationale"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["req_id", "evidence_grade", "fact_ids", "verdict", "gap_type", "note"],
        "additionalProperties": false,
        "properties": {
          "req_id": {"type": "string", "pattern": "^R[0-9]{1,3}$"},
          "evidence_grade": {"enum": ["A", "B", "C", "D", "E"]},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "verdict": {"enum": ["strong", "partial", "no_evidence", "gap", "exceeds"]},
          "gap_type": {"enum": ["expression", "evidence", "ability", "hard", null]},
          "note": {"type": "string", "maxLength": 200}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 10, "maxLength": 800}
  }
}
