{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyze/v1",
  "type": "object",
  "required": ["atomic_requirements", "keywords", "hard_conditions", "flags", "summary"],
  "additionalProperties": false,
  "properties": {
    "atomic_requirements": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "quote", "requirement", "level", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]{1,3}$"},
          "quote": {"type": "string", "minLength": 2},
          "requirement": {"type": "string", "minLength": 2},
          "level": {"enum": ["high", "mid", "low"]},
          "kind": {"enum": ["skill", "experience", "education", "other"]}
        }
      }
    },
    "keywords": {
      "type": "object", "required": ["must", "core", "bonus"], "additionalProperties": false,
      "properties": {
        "must": {"type": "array", "items": {"type": "string"}},
        "core": {"type": "array", "items": {"type": "string"}},
        "bonus": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hard_conditions": {
      "type": "object",
      "required": ["location", "days_per_week", "min_months", "employment_type", "graduated_required", "onsite_days", "visa", "language"],
      "additionalProperties": false,
      "properties": {
        "location": {"type": "array", "items": {"type": "string"}},
        "days_per_week": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
        "min_months": {"type": ["integer", "null"], "minimum": 0},
        "employment_type": {"enum": ["internship", "parttime", "fulltime", "unknown"]},
        "graduated_required": {"type": "boolean"},
        "onsite_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
        "visa": {"enum": ["none", "local_permit_required", "unknown"]},
        "language": {"type": "array", "items": {"type": "string"}}
      }
    },
    "flags": {
      "type": "object", "required": ["entry_level", "remote", "full_time"], "additionalProperties": false,
      "properties": {
        "entry_level": {"type": "boolean"}, "remote": {"type": "boolean"}, "full_time": {"type": "boolean"}
      }
    },
    "summary": {"type": "string", "minLength": 5, "maxLength": 200}
  }
}
